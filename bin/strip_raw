#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'astro_subframe_organizer'
require 'astro_subframe_organizer/utils/raw_stripper'
require 'optparse'

options = {
  output_dir: nil,
  in_place: false,
  force: false,
}

OptionParser.new do |opts|
  opts.banner = <<~DESC
    Strips image data from RAW files (CR2, NEF, ARW, etc.), leaving only metadata.
    The resulting file is a Metadata Information Extraction (MIE) file renamed
    to the original extension, which allows parsers to function with minimal file size.

    Usage: bin/strip_raw [options] <file1.cr2> [file2.nef ...]

    Examples:

      Copy and strip fresh RAW files:
        bundle exec bin/strip_raw -o spec/fixtures/cr2/dark/ /Volumes/SD_CARD/DCIM/100CANON/*.CR2

      Re-strip fixture files in place:
        bundle exec bin/strip_raw --in-place --force spec/fixtures/cr2/**/*.CR2

  DESC

  opts.on('-o', '--output DIR', 'Output directory (default: same as input)') do |dir|
    options[:output_dir] = dir
  end

  opts.on('-i', '--in-place', 'Strip files in place (overwrite originals)') do
    options[:in_place] = true
  end

  opts.on('-f', '--force', 'Re-strip files even if already stripped') do
    options[:force] = true
  end

  opts.on('-h', '--help', 'Show this help') do
    puts opts
    exit
  end
end.parse!

files = ARGV

if files.empty?
  puts 'Error: no input files specified.'
  puts 'Usage: bin/strip_raw [options] <file1.cr2> [file2.cr2 ...]'
  puts 'Run bin/strip_raw --help for options.'
  exit 1
end

invalid = files.reject { |f| File.file?(f) }
if invalid.any?
  puts "Error: not valid files: #{invalid.join(', ')}"
  exit 1
end

if options[:output_dir]
  unless File.directory?(options[:output_dir]) || !File.exist?(options[:output_dir])
    puts "Error: '#{options[:output_dir]}' is not a directory."
    exit 1
  end
  FileUtils.mkdir_p(options[:output_dir])
end

skipped = 0
processed = 0

files.each do |input|
  output_path = options[:output_dir] ? File.join(options[:output_dir], File.basename(input)) : input
  stripper = AstroSubframeOrganizer::Utils::RawStripper.new(input, output_path)

  if !options[:force] && stripper.already_stripped?
    puts "#{File.basename(input)}: already stripped, skipping (use --force to re-strip)"
    skipped += 1
    next
  end

  original_size = File.size(input)
  if stripper.strip
    stripped_size = File.size(output_path)
    puts "#{File.basename(input)}: #{original_size / 1024}KB → #{stripped_size / 1024}KB"
    processed += 1
  else
    puts "#{File.basename(input)}: Failed to strip metadata"
  end
end

puts "Done. #{processed} files processed, #{skipped} skipped."
